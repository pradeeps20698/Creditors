# Copy to .streamlit/secrets.toml (local) OR paste into Streamlit Cloud → App → Settings → Secrets.
# Do NOT commit the real secrets.toml.

# --- swift_party_ref data DB (the dashboard's own data) ---
PGHOST = "your-rds-host.region.rds.amazonaws.com"
PGUSER = "your-username"
PGPASSWORD = "your-password-here"
PGPORT = "5432"
PGDATABASE = "your-database"

# --- Swift Hub user DB (REQUIRED for login + per-user tab/table access) ---
# Paste the SAME [database] block that the Swift Hub app uses. This is a
# separate connection from the PG* keys above and powers require_dashboard_access.
[database]
host = "your-hub-db-host"
port = 5432
user = "your-hub-db-user"
password = "your-hub-db-password"
dbname = "your-hub-db-name"
